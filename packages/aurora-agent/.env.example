# ── Logging ────────────────────────────────────────────────────────────────
# Log level: trace | debug | info | warn | error
LOG_LEVEL=debug
# Set to 1 for colored, human-readable output (default: JSON for production)
LOG_PRETTY=1
# Path to append JSON log lines (set automatically by Tauri; date-rotated on each restart)
# On Windows: %APPDATA%\aurora\logs\aurora-agent.YYYY-MM-DD.log
# On macOS:   ~/Library/Application Support/aurora/logs/aurora-agent.YYYY-MM-DD.log
# On Linux:   ~/.local/share/aurora/logs/aurora-agent.YYYY-MM-DD.log
# LOG_FILE_PATH=C:\Users\user\AppData\Roaming\aurora\logs\aurora-agent.2026-07-04.log

# LLM Provider API Keys
# At least one provider must be configured for the agent to work.

# ── Active provider selection ─────────────────────────────────────────────
# Set to: groq | gemini | openai | anthropic | ollama | nvidia | kimi | gpt-oss
ACTIVE_AI_PROVIDER=groq
# Per-tier model overrides (optional — defaults are set per-provider in aura.ts)
ACTIVE_AI_MODEL_FAST=
ACTIVE_AI_MODEL_BALANCED=
ACTIVE_AI_MODEL_POWERFUL=

# Groq (default provider)
GROQ_API_KEY=gsk_your_key_here

# OpenAI
OPENAI_API_KEY=sk-your-key

# OpenAI-compatible (Ollama, local models, etc.)
GPT_OSS_API_KEY=empty
GPT_OSS_BASE_URL=http://localhost:11434/v1

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Kimi (Moonshot)
KIMI_API_KEY=your_kimi_key

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your_key

# Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_key

# NVIDIA NIM
NVIDIA_API_KEY=your_nvidia_key
