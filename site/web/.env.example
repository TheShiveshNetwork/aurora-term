# Base URL of the deployed aurora-api Supabase Edge Function.
# Local dev (supabase functions serve aurora-api): http://127.0.0.1:54321/functions/v1/aurora-api
# Production: https://<project-ref>.supabase.co/functions/v1/aurora-api
VITE_AURORA_API_URL=

# Public Supabase values — safe to expose in the browser.
VITE_PUBLIC_SUPABASE_URL=
VITE_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Edge Function secrets (server-side only — never prefix with VITE_).
# Set via `supabase secrets set` for the deployed function, or pass this file to
# `supabase functions serve aurora-api --env-file .env.local`.
# New Supabase key model: secret key replaces service_role, publishable key replaces anon.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=